      "actions": [{"type": "propose_memory", "claim": "用户偏好 edit_file 多于 write_file"}],
      "expected": {"status": "proposed", "authority": "inferred", "forbid_active_before_approve": true}
    },
    {
      "id": "inferred-naming-convention",
      "category": "inferred",
      "description": "模型从代码风格推断命名约定",
      "setup": {"agent_run": "scan package names", "success": true},
      "actions": [{"type": "propose_memory", "claim": "Go 包名用单数小写名词"}],
      "expected": {"status": "proposed", "authority": "inferred", "forbid_active_before_approve": true}
    },
    {
      "id": "extractor-rules-edits",
      "category": "inferred",
      "description": "规则抽取器从 edit_file 工具成功事件中提取记忆（authority=repository 经 SaveRepositoryFact 落为 active）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "edit_file", "success": true}
        ]
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "rules", "scope": "project/mengdie", "expect_proposed_count_gte": 0}
      ],
      "expected": {
        "extracted_memories": [
          {"claim_contains": "edit_file", "authority": "repository", "status": "active"}
        ]
      }
    },
    {
      "id": "extractor-rules-tests",
      "category": "inferred",
      "description": "规则抽取器从 go test shell 成功事件中提取记忆（authority=verified 经 SaveVerifiedFact 落为 active）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "shell", "success": true, "summary": "go test ./internal/memory/..."}
        ]
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "rules", "scope": "project/mengdie", "expect_proposed_count_gte": 0}
      ],
      "expected": {
        "extracted_memories": [
          {"claim_contains": "go test", "authority": "verified", "status": "active"}
        ]
      }
    },
    {
      "id": "extractor-rules-lint",
      "category": "inferred",
      "description": "规则抽取器从 golangci-lint shell 成功事件中提取记忆（authority=verified 经 SaveVerifiedFact 落为 active）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "shell", "success": true, "summary": "golangci-lint run ./..."}
        ]
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "rules", "scope": "project/mengdie", "expect_proposed_count_gte": 0}
