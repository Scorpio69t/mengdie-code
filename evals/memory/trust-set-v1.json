{
  "schema_version": 1,
  "id": "memory-trust-set-v1",
  "description": "MengDie Code P2 M3 Slice 01+02 可信记忆 Trust Set v1：35 个跨会话场景，按 explicit 15 / repository 5 / verified 5 / inferred 10 分布；inferred 末 5 个为 M3 Slice 02 Task 9 新增的 MemoryExtractor 集成场景（extractor-rules-* / extractor-llm-* / extractor-hybrid-both）",
  "fixture_root": "../fixtures",
  "tasks": [
    {
      "id": "user-confirms-test-command",
      "category": "explicit",
      "description": "用户显式确认测试入口为 go test ./...",
      "setup": {"seed_memories": []},
      "actions": [{"type": "remember_user", "claim": "用 go test ./... 作为测试入口"}],
      "expected": {"memory_present": true, "claim_match": "用 go test ./... 作为测试入口", "authority": "explicit", "status": "active", "recallable": true, "forbid_duplicate": true, "forbid_old_status_change": false}
    },
    {
      "id": "user-confirms-lint-config",
      "category": "explicit",
      "description": "用户显式确认 lint 工具为 golangci-lint",
      "setup": {"seed_memories": []},
      "actions": [{"type": "remember_user", "claim": "项目使用 golangci-lint run ./... 做静态检查"}],
      "expected": {"memory_present": true, "authority": "explicit", "status": "active", "recallable": true, "forbid_duplicate": true}
    },
    {
      "id": "user-supersede-old-rule",
      "category": "explicit",
      "description": "用户 supersede 旧规则为新规则",
      "setup": {"seed_memories": [{"claim": "用 go test ./internal/foo", "authority": "explicit", "status": "active"}]},
      "actions": [{"type": "remember_user", "claim": "用 go test ./... 全量测试"}, {"type": "supersede", "old_claim": "用 go test ./internal/foo", "new_claim": "用 go test ./... 全量测试"}],
      "expected": {"old_status": "superseded", "new_status": "active", "forbid_duplicate": true}
    },
    {
      "id": "user-cross-project-scope",
      "category": "explicit",
      "description": "用户在不同 project scope 下记录规则",
      "setup": {"seed_memories": [{"claim": "A 项目用 yarn", "authority": "explicit", "status": "active", "scope": "project/a"}]},
      "actions": [{"type": "remember_user", "claim": "B 项目用 npm", "scope": "project/b"}],
      "expected": {"memory_present": true, "claim_match": "B 项目用 npm", "scope_value": "b", "forbid_other_scope_visible": true}
    },
    {
      "id": "user-explicit-forget",
      "category": "explicit",
      "description": "用户显式 forget 一条记忆",
      "setup": {"seed_memories": [{"claim": "已废弃的旧规则", "authority": "explicit", "status": "active"}]},
      "actions": [{"type": "forget", "claim": "已废弃的旧规则", "hard": false}],
      "expected": {"memory_present": false, "status": "archived"}
    },
    {
      "id": "user-hard-forget",
      "category": "explicit",
      "description": "用户 hard forget 一条记忆",
      "setup": {"seed_memories": [{"claim": "硬删除测试", "authority": "explicit", "status": "active"}]},
      "actions": [{"type": "forget", "claim": "硬删除测试", "hard": true}],
      "expected": {"memory_present": false, "evidence_cascade": true}
    },
    {
      "id": "user-confirms-commit-format",
      "category": "explicit",
      "description": "用户显式确认 commit message 格式",
      "setup": {"seed_memories": []},
      "actions": [{"type": "remember_user", "claim": "commit message 用 Conventional Commits"}],
      "expected": {"memory_present": true, "authority": "explicit", "status": "active"}
    },
    {
      "id": "user-confirms-doc-language",
      "category": "explicit",
      "description": "用户显式确认文档语言",
