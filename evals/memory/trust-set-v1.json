    {
      "id": "extractor-llm-tool-pref",
      "category": "inferred",
      "description": "LLM 抽取器（stub provider）从 edit_file/write_file 比例推断工具偏好（authority=inferred 经 ProposeMemory 后被 fingerprint 命中，runtime auto-Approve 升为 active）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "edit_file", "success": true},
          {"kind": "tool.completed", "name": "edit_file", "success": true},
          {"kind": "tool.completed", "name": "edit_file", "success": true},
          {"kind": "tool.completed", "name": "write_file", "success": true}
        ],
        "llm_response": "{\"claim\":\"用户偏好 edit_file 工具多于 write_file\",\"source_type\":\"agent_message\",\"reason\":\"frequency\"}"
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "llm", "scope": "project/mengdie", "expect_proposed_count_gte": 1}
      ],
      "expected": {
        "extracted_memories": [
          {"claim_contains": "偏好 edit_file", "authority": "inferred", "status": "auto-approved"}
        ]
      }
    },
    {
      "id": "extractor-hybrid-both",
      "category": "inferred",
      "description": "Hybrid 抽取器同时跑 Rules 与 LLM（stub），Rules 候选走 SaveRepositoryFact 落为 repository/active，LLM 候选经 fingerprint auto-Approve 落为 inferred/active（避免 spec §4.2 同 authority 不同 claim 的 dispute 翻转）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "edit_file", "success": true}
        ],
        "llm_response": "{\"claim\":\"用户偏好 edit_file 工具多于 write_file\",\"source_type\":\"agent_message\",\"reason\":\"preference\"}"
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "hybrid", "scope": "project/mengdie", "expect_proposed_count_gte": 1}
      ],
      "expected": {
        "extracted_memories": [
          {"claim_contains": "edit_file 修改文件", "authority": "repository", "status": "active"},
          {"claim_contains": "偏好 edit_file", "authority": "inferred", "status": "auto-approved"}
        ]
      }
    },
    {
