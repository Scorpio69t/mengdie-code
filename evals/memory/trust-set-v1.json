      "category": "inferred",
      "description": "规则抽取器从 golangci-lint shell 成功事件中提取记忆，claim 命中 fingerprint；Rules 路径直接落为 active（authority=verified 经 SaveVerifiedFact）",
      "setup": {
        "seed_events": [
          {"kind": "tool.completed", "name": "shell", "success": true, "summary": "golangci-lint run ./..."}
        ]
      },
      "actions": [
        {"type": "run_run"},
        {"type": "extract", "extractor": "rules", "scope": "project/mengdie", "expect_proposed_count_gte": 0}
