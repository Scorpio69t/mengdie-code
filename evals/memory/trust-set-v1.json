      "category": "explicit",
      "description": "用户显式确认凭据处理规则",
      "setup": {"seed_memories": []},
      "actions": [{"type": "remember_user", "claim": "凭据只在受保护 Environment 注入，不进仓库"}],
      "expected": {"memory_present": true, "authority": "explicit"}
    },
    {
      "id": "user-agents-md-style",
      "category": "explicit",
